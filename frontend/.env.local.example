# ── Brevo SMTP (gratis, 300 emails/día) ────────────────────────
# Tu email de login en Brevo
BREVO_SMTP_USER=ohb.seven@gmail.com

# SMTP Key generada en Brevo → SMTP & API → Generate a new SMTP key
BREVO_SMTP_KEY=xsmtp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Brevo Contacts API (gestión de suscriptores newsletter) ──────
# API Key generada en Brevo → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID de la lista de newsletter en Brevo → Contacts → Lists
BREVO_LIST_ID=1

# ── Seguridad (newsletter double opt-in + unsubscribe) ───────────
# Secreto HMAC para firmar tokens de confirmación, baja y borrado de datos
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BROADCAST_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Configuración de envío ──────────────────────────────────────
# Nombre que verán los destinatarios en el "De:" (debe coincidir con un sender verificado en Brevo)
MAIL_FROM=Diamadmin <ohb.seven@gmail.com>

# Email que recibe las notificaciones internas (contacto, newsletter, sugerencias)
CONTACT_NOTIFY_EMAIL=ohb.seven@gmail.com

# ── Solo desarrollo ─────────────────────────────────────────────
# Redirige TODOS los emails a esta dirección en vez del usuario real
# Descomenta para pruebas locales, NO incluir en Cloudflare Pages
# MAIL_TEST_TO=ohb.seven@gmail.com
